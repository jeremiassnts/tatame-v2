# PostgreSQL (required for API and Drizzle migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tatame

# Redis — required for check-in locks (spec §7); see docker-compose.yml
REDIS_URL=redis://localhost:6379

NODE_ENV=development
API_PORT=3001

# Clerk — https://dashboard.clerk.com
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# Comma-separated allowed JWT audiences (Expo dev server, Next.js origin, etc.)
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:8081

# Email (Resend) — optional, emails are skipped when unset
# RESEND_API_KEY=re_...

# Optional: seed (`pnpm --filter api seed`) uses repo-root .env via --env-file=../../.env
# If unset, the seed script uses synthetic values for the demo manager row.
# MANAGER_CLERK_ID=user_xxxxxxxx
# MANAGER_EMAIL=manager@example.com


# ── Observability (optional) ──────────────────────────────────────────────
# OTLP/gRPC endpoint of the OpenTelemetry Collector. Leave unset to disable
# telemetry entirely. Start the stack with:
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
# From the host use localhost; from inside a container use otel-collector.
# OTEL_COLLECTOR_URL=http://localhost:4317
# How often metrics are pushed, in ms (default 10000). Lower for live demos.
# OTEL_METRIC_EXPORT_INTERVAL=5000
# service.name resource attribute (default tatame-api)
# OTEL_SERVICE_NAME=tatame-api
# Groups every service of this product; becomes the `service_namespace` label.
# OTEL_SERVICE_NAMESPACE=tatame
# Traces share OTEL_COLLECTOR_URL with metrics. Set to false to keep metrics only.
# OTEL_TRACES_ENABLED=true
# Logs share it too. Set to false to stop exporting them; stdout is unaffected.
# OTEL_LOGS_ENABLED=true
# Lowest level the logger emits: debug | info | warn | error (default info).
# Also the switch that un-silences logs under NODE_ENV=test.
# LOG_LEVEL=info
#
# ── In production (set these on the API resource in Coolify) ──
# The Collector lives in the observability compose stack, whose container names
# carry that stack's uuid. See docs/observability.md, "Deploying to Coolify".
# OTEL_COLLECTOR_URL=http://otel-collector-<uuid>:4317
# 10s is a demo cadence; 30s is plenty once nobody is watching the dashboard live.
# OTEL_METRIC_EXPORT_INTERVAL=30000
# The SDK default records *every* request. These two sample 10% instead. They are
# read by the SDK itself, not by packages/config/src/env.ts, so there is no schema
# entry for them and no code path to change.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
