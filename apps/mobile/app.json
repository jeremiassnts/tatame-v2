{
  "expo": {
    "name": "Tatame",
    "slug": "tatame",
    "version": "2.1.4",
    "orientation": "portrait",
    "scheme": "tatame",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.tatame",
      "associatedDomains": [
        "applinks:apptatame.com.br"
      ],
      "icon": "./assets/images/apple-icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Este app precisa de acesso à câmera para capturar fotos e vídeos.",
        "NSPhotoLibraryUsageDescription": "Este app precisa de acesso à biblioteca de fotos para salvar e carregar mídias.",
        "NSPhotoLibraryAddUsageDescription": "Este app precisa de permissão para salvar fotos na sua biblioteca.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "pt-BR"
        ]
      },
      "buildNumber": "3"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C0C0C"
      },
      "package": "com.anonymous.tatame",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "apptatame.com.br",
              "pathPrefix": "/convite/"
            },
            {
              "scheme": "https",
              "host": "apptatame.com.br",
              "path": "/baixar"
            }
          ]
        }
      ],
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-system-ui",
        {
          "backgroundColor": "#0C0C0C"
        }
      ],
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": []
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C0C0C",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "managerPortalUrl": "https://apptatame.com.br/conta",
      "managerSignupUrl": "https://apptatame.com.br/cadastro",
      "eas": {
        "projectId": "521fca59-6f7d-4701-bdde-b061eed2c7c2"
      }
    }
  }
}
