                  "fontFamily": "Sora",
                  "fontSize": 18,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "9Lqv0",
                  "fill": "$--text-secondary",
                  "textGrowth": "fixed-width",
